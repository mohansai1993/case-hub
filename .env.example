APP_NAME="Case Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=case_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Production: serve over HTTPS and set SESSION_SECURE_COOKIE=true
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Forgot-password OTP. "log" writes emails to storage/logs/laravel.log (dev).
# Production: use smtp (or another mailer) and implement App\Contracts\SmsGateway.
# For Gmail SMTP: MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls,
# MAIL_USERNAME=<gmail address>, MAIL_PASSWORD=<16-char Gmail App Password,
# not your normal password - Google Account > Security > App Passwords>.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
SMS_DRIVER=log
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_RESET_TOKEN_TTL_MINUTES=15

# First Super Admin for `php artisan db:seed`. Local has a dev default;
# elsewhere ADMIN_SEED_PASSWORD is required or the admin is not created.
ADMIN_SEED_NAME="Super Admin"
ADMIN_SEED_EMAIL=admin@casehub.test
ADMIN_SEED_MOBILE=
ADMIN_SEED_PASSWORD=

# Mobile API (clients / lawyers)
APP_OTP_LENGTH=4
APP_OTP_TTL_MINUTES=10
APP_OTP_RESEND_SECONDS=59
APP_OTP_MAX_ATTEMPTS=5
API_TOKEN_TTL_MINUTES=10080
API_TOKEN_REMEMBER_TTL_MINUTES=43200

# Push notifications (Firebase Cloud Messaging, HTTP v1 API).
# "log" writes to storage/logs/laravel.log instead of calling Firebase (dev).
# Put the service account JSON at storage/app/firebase/service-account.json
# (never commit it - see .gitignore).
PUSH_DRIVER=log
FIREBASE_PROJECT_ID=
GOOGLE_CREDENTIALS_PATH=storage/app/firebase/service-account.json
FIREBASE_URL=
FIREBASE_SCOPE_MESSAGE_URL=https://www.googleapis.com/auth/firebase.messaging

# Real-time chat (Laravel Reverb - `php artisan reverb:start`).
# Generate your own APP_ID/KEY/SECRET per environment (never share prod's).
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Client storage-plan billing (monthly auto-recurring). "log" never charges a
# real card (dev only) - see docs/06-billing-and-storage.md before going live.
BILLING_DRIVER=log
BILLING_CURRENCY=NGN
BILLING_CURRENCY_SYMBOL="₦"
BILLING_GRACE_DAYS=7
